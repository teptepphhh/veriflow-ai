# Copy this file to .env and edit the values.

# Port the server listens on
PORT=3000

# Shared secret for POST /api/validate and DELETE /api/logs (sent as x-api-key header).
# The dashboard (public/app.js) uses this same default; change both together.
API_KEY=veriflow-local-key

# Optional: Gemini API key from https://aistudio.google.com/apikey
# Leave empty to use the built-in rule-based explanation.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-3.5-flash-lite).
# If you see "HTTP 404" in the server log, the model was probably retired;
# check https://ai.google.dev/gemini-api/docs/models for current names.
GEMINI_MODEL=

# Optional: how many milliseconds to wait for Gemini before using the
# rule-based fallback (default 20000 = 20 seconds).
GEMINI_TIMEOUT_MS=

# Optional: Discord or Slack incoming-webhook URL for drift alerts.
# Leave empty to skip alerts.
WEBHOOK_URL=
